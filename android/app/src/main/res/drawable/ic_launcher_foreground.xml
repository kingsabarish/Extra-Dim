<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a brightness sun (drawn below a horizontal dim
     bar), with the sun clipped/dimmed to suggest reduced brightness. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Sun disc, partly hidden behind the dim bar. -->
    <path
        android:fillColor="#FFD54F"
        android:pathData="M54,30 m-20,0 a20,20 0 1,1 40,0 a20,20 0 1,1 -40,0 Z" />
    <!-- Sun rays. -->
    <path
        android:strokeColor="#FFD54F"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,6 L54,13 M26,18 L31,23 M82,18 L77,23 M54,78 L54,71 M37,66 L32,71 M71,66 L76,71" />
    <!-- Dim bar covering the lower part of the sun. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18,54 H90 V61 H18 Z" />
</vector>
